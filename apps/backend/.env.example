# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chronic_covid19
POSTGRES_SERVER=localhost  # Use 'db' if running with Docker

# Redis Configuration
REDIS_URL=redis://localhost:6379/0  # Use 'redis://redis:6379/0' if running with Docker

# Security
SECRET_KEY=your-secret-key-here  # Change this to a secure random string in production

# Application Settings
PROJECT_NAME=Chronic COVID-19 Monitoring System

# Email / SMTP (opcional)
# Si SMTP_HOST y SMTP_USER están vacíos, el envío de correos se omite (no rompe la importación).
SMTP_HOST=            # ej: smtp.gmail.com
SMTP_PORT=587
SMTP_USER=            # usuario/cuenta SMTP
SMTP_PASSWORD=        # contraseña o app password
SMTP_FROM=            # remitente (por defecto = SMTP_USER)
SMTP_FROM_NAME=Salud en Mapa
SMTP_STARTTLS=true    # true para STARTTLS (puerto 587), false para conexión sin TLS

# URL pública del frontend (para enlaces en los correos)
FRONTEND_URL=https://www.saludenmapa.com

# Minutos de validez del token de recuperación de contraseña
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30