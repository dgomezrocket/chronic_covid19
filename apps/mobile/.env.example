# URL base del backend (FastAPI) expuesta al bundle por Expo (prefijo EXPO_PUBLIC_).
# Tras cambiar este archivo, reiniciar Expo con caché limpia: npx expo start -c
#
#  - Emulador Android:            http://10.0.2.2:8000
#  - Dispositivo físico (Expo Go): http://192.168.x.x:8000   (misma red; backend con --host 0.0.0.0)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Google Maps API key para Android, requerida por react-native-maps: sin ella el
# APK aborta al abrir un mapa con "IllegalStateException: API key not found."
# (en Expo Go no hace falta, porque Expo Go usa su propia key).
#
# Se consume al evaluar app.config.js durante el build, no desde el bundle, por
# eso NO lleva prefijo EXPO_PUBLIC_. En builds de EAS se toma de las Environment
# Variables del proyecto, no de este archivo:
#   eas env:create --name GOOGLE_MAPS_ANDROID_API_KEY --value "AIza..." \
#     --environment development --environment preview --environment production \
#     --visibility sensitive
#
# La key viaja embebida en el APK, así que protegerla restringiéndola en Google
# Cloud Console: Application restrictions → Android apps → package
# com.covid19monitor.app + huella SHA-1 del keystore (`eas credentials`), y
# API restrictions → solo "Maps SDK for Android".
GOOGLE_MAPS_ANDROID_API_KEY=AIza...
